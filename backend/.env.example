PORT=5001
# IMPORTANT: Your machine's public IP MUST be allowed in MongoDB Atlas Network Access.
MONGODB_URI=
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000

# Public Widget URL (for embed code generation)
PUBLIC_WIDGET_URL=http://localhost:5001/widget
GROQ_API_KEY=your_groq_api_key_here
REDIS_URL=redis://localhost:6379
GROQ_MODEL=llama-3.1-8b-instant
JWT_SECRET=
JWT_EXPIRES_IN=7d
